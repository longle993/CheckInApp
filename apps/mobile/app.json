{
  "expo": {
    "name": "CheckInApp",
    "slug": "checkinapp",
    "version": "0.2.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Quét thẻ học sinh để điểm danh."
      }
    },
    "android": {
      "package": "com.checkinapp.mobile",
      "permissions": [
        "CAMERA"
      ]
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Cho phép CheckInApp quét thẻ học sinh.",
          "recordAudioAndroid": false
        }
      ],
      "expo-secure-store"
    ]
  }
}